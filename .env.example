STOPSLOP_MAIN_BASE_URL=https://integrate.api.nvidia.com/v1
STOPSLOP_MAIN_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
STOPSLOP_MAIN_KEY=
STOPSLOP_POLICY=block
STOPSLOP_FALLBACK_BASE_URL=
STOPSLOP_FALLBACK_MODEL=
STOPSLOP_FALLBACK_KEY=
STOPSLOP_RULES_FILE=
STOPSLOP_POLICY_FILE=
STOPSLOP_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
STOPSLOP_LOCAL_MODEL=
STOPSLOP_LOCAL_KEY=local
STOPSLOP_TIMEOUT=120

# Local semantic classifier (install the laya extra)
STOPSLOP_CLASSIFIER=laya
STOPSLOP_LAYA_MODEL=convaiinnovations/laya
STOPSLOP_LAYA_DEVICE=cpu

# Required only when classifier is jev
STOPSLOP_JEV_KEY=
STOPSLOP_JEV_BASE_URL=https://api.typesafe.ai/v1
STOPSLOP_JEV_MODEL=jev-latest
STOPSLOP_DETERMINISTIC=false

# Persistent state shared by gateway, SDK/demo, and administrative generation
STOPSLOP_STATE_FILE=stopslop.sqlite3
# JSON map of client ID to bearer token; keep real values only in ignored .env
STOPSLOP_ACCESS_TOKENS=
# Demo client credential when authenticated enforcement is enabled
STOPSLOP_CLIENT_TOKEN=
# Optional externally managed additive policy (read-only configuration)
STOPSLOP_DYNAMIC_POLICY_FILE=

# Persist original messages and delivered replies only when explicitly enabled
STOPSLOP_LOG_CHATS=false
STOPSLOP_MAX_REQUEST_BYTES=2097152
STOPSLOP_MAX_RESPONSE_BYTES=4194304
