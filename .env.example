# One upstream configuration for NVIDIA, OpenAI or Ollama.
# Local defaults work after just setup. Set all four values for hosted chat.
STOPSLOP_PROVIDER=ollama
STOPSLOP_BASE_URL=http://127.0.0.1:11434/v1
STOPSLOP_MODEL=qwen3:0.6b
STOPSLOP_KEY=ollama

# Runtime configuration, never part of policy.toml.
STOPSLOP_POLICY_FILE=policy.toml
STOPSLOP_CLASSIFIER=laya
STOPSLOP_JEV_KEY=
# just setup installs the laya extra; first demo downloads classifier weights.
STOPSLOP_LAYA_MODEL=convaiinnovations/laya
STOPSLOP_LAYA_DEVICE=cpu
# Independent local assessment backend for exhausted classifier budgets.
STOPSLOP_FALLBACK_CLASSIFIER=ollama

# Privacy/budget local route: qwen3:0.6b is approved in policy.toml.
STOPSLOP_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
STOPSLOP_LOCAL_MODEL=qwen3:0.6b
STOPSLOP_LOCAL_KEY=local
# Optional trusted hosted fallback route.
# STOPSLOP_FALLBACK_BASE_URL=
# STOPSLOP_FALLBACK_MODEL=
# STOPSLOP_FALLBACK_KEY=

STOPSLOP_STATE_FILE=stopslop.sqlite3
STOPSLOP_TIMEOUT=120
STOPSLOP_LOG_CHATS=true
# Authentication: JSON map of client ID to bearer token.
# STOPSLOP_ACCESS_TOKENS={"demo-agent":"replace-with-a-secret"}
# STOPSLOP_CLIENT_TOKEN=
# STOPSLOP_DYNAMIC_POLICY_FILE=
# STOPSLOP_MAX_REQUEST_BYTES=2097152
# STOPSLOP_MAX_RESPONSE_BYTES=4194304

STOPSLOP_AUTOGEN=true

STOPSLOP_AUTOGEN_OUTPUT_FILE=policy.dyn.toml
