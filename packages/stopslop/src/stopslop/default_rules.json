[
  {"id":"pesel","pattern":"(?<!\\d)(?:\\d[ -]?){10}\\d(?!\\d)","validator":"pesel"},
  {"id":"bank_account","pattern":"(?<!\\w)(?:PL[ ]?)?(?:\\d[ ]?){25}\\d(?!\\d)","validator":"bank"},
  {"id":"phone","pattern":"(?<!\\w)(?:\\+48[ .-]?)?(?:\\d[ .-]?){8}\\d(?!\\d)"},
  {"id":"polish_name","pattern":"\\b(?:Jan|Anna|Piotr|Maria|Katarzyna|Tomasz|Franciszek)\\s+(?:Kowalsk[ai]|Nowak|Wiśniewsk[ai]|Łopuszańsk[ai])\\b"},
  {"id":"email","pattern":"(?<![\\w.+-])[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)+"},
  {"id":"international_phone","pattern":"(?<!\\w)\\+(?!48(?:[ .-]|\\d))\\d(?:[ .-]?\\d){6,14}(?!\\d)"},
  {"id":"domestic_phone","pattern":"(?<!\\w)(?:\\(\\d{3}\\)[ .-]?|\\d{3}[ .-])\\d{3}[ .-]\\d{4}(?!\\d)"},
  {"id":"iban","pattern":"\\b(?:(?:DE|GB|IE)\\d{2}(?:[ ]?[A-Z0-9]){18}|PL\\d{2}(?:[ ]?[A-Z0-9]){24}|(?:FR|IT)\\d{2}(?:[ ]?[A-Z0-9]){23}|ES\\d{2}(?:[ ]?[A-Z0-9]){20}|NL\\d{2}(?:[ ]?[A-Z0-9]){14}|BE\\d{2}(?:[ ]?[A-Z0-9]){12}|CH\\d{2}(?:[ ]?[A-Z0-9]){17}|AT\\d{2}(?:[ ]?[A-Z0-9]){16}|PT\\d{2}(?:[ ]?[A-Z0-9]){21})\\b","validator":"iban"},
  {"id":"credit_card","pattern":"(?<!\\d)(?:\\d[ -]?){12,18}\\d(?!\\d)","validator":"luhn"},
  {"id":"personal_name","pattern":"\\b(?:full name|name|imię i nazwisko)\\s*:\\s*[^\\W\\d_]+(?:[ '-][^\\W\\d_]+){1,3}"},
  {"id":"address","pattern":"\\b(?:address|adres)\\s*:\\s*[^\\r\\n;]{3,120}"},
  {"id":"date_of_birth","pattern":"\\b(?:date of birth|dob|data urodzenia)\\s*:\\s*\\d{1,4}[./-]\\d{1,2}[./-]\\d{1,4}"},
  {"id":"national_id","pattern":"\\b(?:ssn|passport|national id|dowód osobisty)\\s*:\\s*[A-Z0-9][A-Z0-9 -]{4,24}"},
  {"id":"secret","pattern":"\\b(?:password|passwd|api[_ -]?key|access[_ -]?token|hasło)\\s*[:=]\\s*[^\\s;,]+"},
  {"id":"private_key","pattern":"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----[\\s\\S]*?(?:-----END (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|$)"},
  {"id":"profanity","pattern":"\\b(?:fuck(?:ing|ed|er|ers)?|shit(?:ty)?|bitch(?:es)?|asshole|kurwa|kurwy|kurwo|chuj|pierdolić|jebać)\\b"}
]
