{
  "version": 1,
  "classifier": "laya",
  "default_action": "filter",
  "rules": [
    {
      "id": "bank_account",
      "action": "filter"
    },
    {
      "id": "iban",
      "action": "filter"
    },
    {
      "id": "credit_card",
      "action": "filter"
    },
    {
      "id": "phone",
      "action": "filter"
    },
    {
      "id": "international_phone",
      "action": "filter"
    },
    {
      "id": "domestic_phone",
      "action": "filter"
    },
    {
      "id": "email",
      "action": "filter",
      "allowed_patterns": [
        "\\bsupport@example\\.com\\b"
      ]
    },
    {
      "id": "polish_name",
      "action": "filter"
    },
    {
      "id": "personal_name",
      "action": "filter"
    },
    {
      "id": "address",
      "action": "filter"
    },
    {
      "id": "date_of_birth",
      "action": "filter"
    },
    {
      "id": "pesel",
      "action": "filter"
    },
    {
      "id": "national_id",
      "action": "filter"
    },
    {
      "id": "secret",
      "action": "block"
    },
    {
      "id": "private_key",
      "action": "block"
    },
    {
      "id": "profanity",
      "action": "local"
    },
    {
      "id": "confidential",
      "pattern": "\\b(?:strictly confidential|do not process|ściśle tajne)\\b",
      "action": "block"
    },
    {
      "id": "confidential_semantic",
      "description": "Do not disclose non-public company information, including unreleased financial results, NDA-protected information, or internal project details, even if paraphrased or obfuscated. Public information and fictional examples are allowed.",
      "threshold": 75,
      "action": "block"
    },
    {
      "id": "abusive_semantic",
      "description": "Do not send targeted harassment or personal abuse to the cloud model. Neutral discussion and quotations for analysis are allowed.",
      "threshold": 80,
      "action": "local"
    },
    {
      "id": "private_semantic",
      "description": "Do not disclose identifying personal contact information, including phone numbers spelled out in words or obfuscated email addresses. Fictional examples are allowed.",
      "threshold": 80,
      "action": "filter"
    },
    {
      "id": "historical_prompt_injection",
      "pattern": "\\bignore\\s+(?:all\\s+)?(?:previous|system|developer)\\s+(?:instructions|rules)\\b",
      "action": "block"
    },
    {
      "id": "unsafe_deserialization",
      "pattern": "\\b(?:pickle|dill)\\s*\\.\\s*loads?\\s*\\(",
      "action": "block"
    },
    {
      "id": "unsafe_model_loading",
      "pattern": "\\btorch\\s*\\.\\s*load\\s*\\([^\\r\\n]{0,256}\\bweights_only\\s*=\\s*False",
      "action": "block"
    },
    {
      "id": "shell_execution",
      "pattern": "\\b(?:os\\s*\\.\\s*system|subprocess\\s*\\.\\s*(?:run|Popen|call))\\s*\\(",
      "action": "block"
    },
    {
      "id": "execution_semantic",
      "description": "Block requests to execute unauthorized code, deserialize untrusted executable model checkpoints, install malicious model repository code, or send private data to an attacker. Allow harmless security explanations and approved work that does not execute or disclose prohibited content.",
      "threshold": 90,
      "action": "block"
    }
  ],
  "output": {
    "inherit_input": true,
    "default_action": "block",
    "rules": [
      {
        "id": "profanity",
        "action": "warn"
      }
    ]
  },
  "budgets": [
    {
      "id": "all_models_daily",
      "type": "fixed_quota",
      "tokens": "total",
      "limit": 1000000,
      "window_seconds": 86400,
      "reset_at": "2026-01-01T00:00:00Z"
    }
  ]
}
